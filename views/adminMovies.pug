extends layout
include mixins

block content
  include menu
  main.container
    h1 Gestionar películas

    button.btn.btn--primary#toggleCreate(type="button" aria-expanded="false" aria-controls="createForm") + Crear nueva

    //- Oculto hasta pulsar "Crear nueva" (lo controla menu.js)
    form.form.panel#createForm(method="POST" action="/api/movie" hidden)
      h2 Nueva película
      +movieFields()
      button.btn.btn--primary(type="submit") Guardar

    if movies && movies.length
      .grid
        each movie in movies
          +movieCard(movie)
            //- PUT y DELETE se harán con fetch desde JS (data-id = id de MongoDB)
            button.btn.btn--ghost.js-edit-movie(type="button" data-id=movie.id) Editar
            button.btn.btn--danger.js-delete-movie(type="button" data-id=movie.id) Eliminar
    else
      p.empty No hay películas en la base de datos.
