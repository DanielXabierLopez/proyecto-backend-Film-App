extends layout

block content
  include menu
  main.container
    h1 Usuarios

    form.form.panel(method="POST" action="/api/signup")
      h2 Nuevo usuario
      label(for="name") Nombre
      input#name(type="text" name="name" required)
      label(for="email") Email
      input#email(type="email" name="email" required)
      label(for="password") Contraseña
      input#password(type="password" name="password" required minlength="6")
      button.btn.btn--primary(type="submit") Crear usuario

    if users && users.length
      ul.user-list
        each u in users
          li.user-list__item
            .user-list__info
              strong= u.name
              span.muted= u.email
              span.tag= u.role
            .user-list__actions
              //- PUT y DELETE /api/user se harán con fetch desde JS
              button.btn.btn--ghost.js-edit-user(type="button" data-id=u.id) Editar
              button.btn.btn--danger.js-delete-user(type="button" data-id=u.id) Borrar
    else
      p.empty No hay usuarios registrados.
